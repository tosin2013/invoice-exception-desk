        if not any((v or '').strip() for v in r.values()): raise ValueError
        for f in ['issuer','invoice_id','issue_date','due_date','amount_cents','currency','paid_cents']:
            if not (r.get(f) or '').strip(): raise ValueError
        date.fromisoformat(r['issue_date']); date.fromisoformat(r['due_date'])
        a=int(r['amount_cents']); p=int(r['paid_cents'])
        if a<0 or p<0 or p>a: raise ValueError
        if r['currency']!='USD': raise ValueError
    except Exception:
        counts['rejected']+=1; continue
    key=(r['issuer'],r['invoice_id']); vals=tuple(r[f] for f in ['issuer','invoice_id','issue_date','due_date','amount_cents','currency','paid_cents'])
    if key in seen:
        counts['duplicate_identical' if seen[key]==vals else 'duplicate_inconsistent']+=1; continue
    seen[key]=vals; counts['accepted']+=1; acc.append(r)
print(counts, 'total', len(rows))
out=[int(r['amount_cents'])-int(r['paid_cents']) for r in acc]
print('outstanding', sum(out), sum(1 for x in out if x>0), 'paid', sum(int(r['paid_cents']) for r in acc))
buckets={}
for r in acc:
    rem=int(r['amount_cents'])-int(r['paid_cents']); d=(as_of-date.fromisoformat(r['due_date'])).days
    b='paid' if rem==0 else 'current' if d<=0 else '1-30' if d<=30 else '31-60' if d<=60 else '61-90' if d<=90 else '91+'
    c,s=buckets.get(b,(0,0)); buckets[b]=(c+1,s+rem)
print(buckets)
