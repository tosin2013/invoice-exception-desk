import csv, datetime
rows=list(csv.DictReader(open('data/invoices.csv')))
as_of=datetime.date(2026,10,15)
acc=[r for r in rows[:14]]
bal=lambda r:int(r['amount_cents'])-int(r['paid_cents'])
print('outstanding sum', sum(bal(r) for r in acc), 'count', sum(1 for r in acc if bal(r)>0))
print('paid sum', sum(int(r['paid_cents']) for r in acc))
from collections import defaultdict
buckets=defaultdict(lambda:[0,0])
for r in acc:
    b=bal(r); d=(as_of-datetime.date.fromisoformat(r['due_date'])).days
    if b==0: k='paid'
    elif d<=0: k='current'
    elif d<=30:k='1-30'
    elif d<=60:k='31-60'
    elif d<=90:k='61-90'
    else:k='91+'
    buckets[k][0]+=1; buckets[k][1]+=b
    print(r['invoice_id'],b,d,k)
print(dict(buckets))
