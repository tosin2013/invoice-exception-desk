import json
import tempfile
from datetime import date
from pathlib import Path
from invoice_desk import (
    accepted_invoice_identities, attach_annotations, build_followup_queue,
    followup_queue, import_invoices, load_annotations, set_notes, set_owner,
    AnnotationStoreMalformedError, AnnotationStoreVersionError,
    AnnotationStoreDuplicateIdentityError, InvoiceNotAcceptedError,
)

csv_text = Path("data/invoices.csv").read_text(encoding="utf-8")
result = import_invoices(csv_text, date(2026, 10, 15))
expected = ['INV-1009', 'INV-1012', 'INV-1008', 'INV-1007', 'INV-1005', 'INV-1006',
            'INV-1014', 'INV-1004', 'INV-1003', 'INV-1010', 'INV-1001', 'INV-1002',
            'INV-1013', 'INV-1011']
queue = build_followup_queue(result)
assert [i["invoice_id"] for i in queue] == expected, "section 2 order"
assert [i["position"] for i in queue] == list(range(1, 15))
assert queue[-1]["aging_bucket"] == "paid" and queue[-1]["remaining_balance_cents"] == 0
assert all(i["owner"] is None and i["notes"] is None for i in queue)
print("section 2 ok")

assert build_followup_queue(result) == build_followup_queue(result)
assert build_followup_queue(result) == build_followup_queue(import_invoices(csv_text, date(2026, 10, 15)))
print("section 3 ok")

ids = accepted_invoice_identities(result)
with tempfile.TemporaryDirectory() as tmp:
    store = Path(tmp) / "followup_annotations.json"
    set_owner(ids, "Acme Cleaning Co", "INV-1001", "Dana", store_path=store)
    set_notes(ids, "Acme Cleaning Co", "INV-1002", "Call Tuesday.\nAsk for AP.", store_path=store)
    first = followup_queue(result, store)
    second = followup_queue(result, store)
    by_id = {i["invoice_id"]: i for i in first}
    assert by_id["INV-1001"]["owner"] == "Dana" and by_id["INV-1001"]["notes"] is None
    assert by_id["INV-1002"]["owner"] is None
    assert by_id["INV-1002"]["notes"] == "Call Tuesday.\nAsk for AP."
    assert [i["invoice_id"] for i in first] == [i["invoice_id"] for i in second] == expected
    assert store.exists()
    print("section 4 ok")

    # restart simulation
    assert load_annotations(store)[("Acme Cleaning Co", "INV-1002")]["notes"] == "Call Tuesday.\nAsk for AP."
    # clearing independence
    set_owner(ids, "Acme Cleaning Co", "INV-1002", None, store_path=store)
    assert load_annotations(store)[("Acme Cleaning Co", "INV-1002")]["notes"] == "Call Tuesday.\nAsk for AP."
    set_notes(ids, "Acme Cleaning Co", "INV-1001", "n", store_path=store)
    set_owner(ids, "Acme Cleaning Co", "INV-1001", None, store_path=store)
    assert load_annotations(store)[("Acme Cleaning Co", "INV-1001")]["notes"] == "n"

    # missing store
    missing = Path(tmp) / "missing.json"
    missing_queue = followup_queue(result, missing)
    assert all(i["owner"] is None and i["notes"] is None for i in missing_queue)
    assert not missing.exists()

    # malformed
    bad = Path(tmp) / "bad.json"
    bad.write_text("{not json", encoding="utf-8")
    before = bad.read_bytes()
    try:
        set_owner(ids, "Acme Cleaning Co", "INV-1001", "Dana", store_path=bad)
        raise AssertionError("expected malformed")
    except AnnotationStoreMalformedError:
        pass
    assert bad.read_bytes() == before

    # unsupported version
    v2 = Path(tmp) / "v2.json"
    v2.write_text(json.dumps({"version": 2, "annotations": []}), encoding="utf-8")
    before = v2.read_bytes()
    try:
        load_annotations(v2); raise AssertionError("expected version error")
    except AnnotationStoreVersionError:
        pass
    assert v2.read_bytes() == before

    # duplicate identity
    dup = Path(tmp) / "dup.json"
    rec = {"issuer": "A", "invoice_id": "I", "owner": "", "notes": ""}
    dup.write_text(json.dumps({"version": 1, "annotations": [rec, rec]}), encoding="utf-8")
    before = dup.read_bytes()
    try:
        load_annotations(dup); raise AssertionError("expected duplicate error")
    except AnnotationStoreDuplicateIdentityError:
        pass
    assert dup.read_bytes() == before

    # not accepted
    try:
        set_owner(ids, "Acme Cleaning Co", "INV-9001", "Dana", store_path=store)
        raise AssertionError("expected not accepted")
    except InvoiceNotAcceptedError:
        pass
    print("section 5 ok")

    # annotation changes do not reorder
    before_q = followup_queue(result, missing)
    set_owner(ids, "Acme Cleaning Co", "INV-1003", "Dana", store_path=store)
    after_q = followup_queue(result, store)
    assert [(i["invoice_id"], i["position"], i["remaining_balance_cents"], i["days_overdue"], i["aging_bucket"]) for i in before_q] == \
           [(i["invoice_id"], i["position"], i["remaining_balance_cents"], i["days_overdue"], i["aging_bucket"]) for i in after_q]
    print("section 6 ok")

    # retained annotation for absent identity
    set_owner(ids, "Bright Path Facilities", "INV-1013", "Eve", store_path=store)
    other = import_invoices("\n".join([
        "issuer,invoice_id,issue_date,due_date,amount_cents,currency,paid_cents",
        "Bright Path Facilities,INV-1014,2026-09-14,2026-09-14,1,USD,0",
    ]), date(2026, 10, 15))
    other_q = followup_queue(other, store)
    assert [i["invoice_id"] for i in other_q] == ["INV-1014"]
    assert ("Bright Path Facilities", "INV-1013") in load_annotations(store)
    again = followup_queue(result, store)
    assert {i["invoice_id"]: i for i in again}["INV-1013"]["owner"] == "Eve"
    print("section 7 ok")
print("quickstart sections 2-7 passed")
